# หน้าสาธารณะเปิดได้โดยไม่มี credentials
# db:setup สร้างไฟล์ .env local พร้อมรหัสผ่านใหม่โดยไม่แสดงค่าลับ
DATABASE_URL=
SHADOW_DATABASE_URL=
TEST_DATABASE_URL=
BETTER_AUTH_URL=http://localhost:3000
BETTER_AUTH_SECRET=
TEST_AUTH_SECRET=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# เมื่อเพิ่มพื้นที่ไฟล์ส่วนตัว ต้องอยู่นอก public และตรวจสิทธิ์ผ่าน server
PRIVATE_STORAGE_PATH=
